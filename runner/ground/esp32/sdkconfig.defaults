CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# With Wi-Fi (ESP-NOW, UDP) the app is ~1 MB: the 1.5 MB app partition (same offsets: the bootloader, the partition
# table at 0x8000, the settings at 0x9000 and the app at 0x10000; fits a 2 MB flash).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
