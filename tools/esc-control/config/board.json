  "appCopy": {
    "summary": "8 configurable channels · Digital + 12-bit ADC · USB serial",
    "generator": "Output is {{board.signal.min}}–{{board.signal.max}} V logic. Every generator button belongs to the preset. Continuous output stops on focus loss or a lost host lease.",
    "analog": "Analog pin voltage must stay within {{board.signal.min}}–{{board.signal.max}} V. Measurement ranges depend on each channel’s configured attenuation; see Wiring diagram. Use a physical divider for higher voltage; software scaling changes displayed units only.",
    "analogFootnote": "Channels are converted sequentially using the ADC oneshot driver. Actual timing is recorded. This is a slow signal logger, not a high-speed analog oscilloscope. Factory calibration is used when present. ADC2 is available because Wi-Fi is off.",
    "footer": "Signal Workbench · dedicated USB instrument"
  }
