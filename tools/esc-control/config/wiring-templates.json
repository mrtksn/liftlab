    "parameters": [
      {
        "id": "rTop",
        "label": "R1 · source side (kΩ)",
        "type": "number",
        "value": 20,
        "min": 1,
        "max": 1000
      },
      {
        "id": "rBottom",
        "label": "R2 · to GND (kΩ)",
        "type": "number",
        "value": 10,
        "min": 1,
        "max": 1000
      },
      {
        "id": "sourceV",
        "label": "Source voltage to check (V)",
        "type": "number",
        "value": 5.5,
        "min": 0,
        "max": 12
      },
      {
        "id": "capNf",
        "label": "C1 capacitance (nF)",
        "type": "number",
        "value": 100,
        "min": 1,
        "max": 100000
      }
    ],
    "calculations": {
      "ratio": [
        "add",
        1,
        [
          "divide",
          {
            "ref": "params.rTop"
          },
          {
            "ref": "params.rBottom"
          }
        ]
      ],
      "pinVoltage": [
        "divide",
        {
          "ref": "params.sourceV"
        },
        {
          "ref": "calc.ratio"
        }
      ],
      "sourceMin": [
        "multiply",
        {
          "ref": "adc.min"
        },
        {
          "ref": "calc.ratio"
        }
      ],
      "sourceMax": [
        "min",
        12,
        [
          "multiply",
          {
            "ref": "adc.max"
          },
          {
            "ref": "calc.ratio"
          }
        ]
      ],
      "sourcePinLimit": [
        "multiply",
        {
          "ref": "board.signal.max"
        },
        {
          "ref": "calc.ratio"
        }
      ],
      "cutoffHz": [
        "divide",
        1,
        [
          "multiply",
          2,
          3.141592653589793,
          [
            "divide",
            [
              "multiply",
              {
                "ref": "params.rTop"
              },
              {
                "ref": "params.rBottom"
              },
              1000
            ],
            [
              "add",
              {
                "ref": "params.rTop"
              },
              {
                "ref": "params.rBottom"
              }
            ]
          ],
          {
            "ref": "params.capNf"
          },
          1e-09
        ]
      ]
    },
    "limits": [
      {
        "text": "{{channel.pinLabel}}: keep within {{board.signal.min}}–{{board.signal.max}} V"
      },
      {
        "text": "{{channel.attenuation}} dB measurement range: {{adc.min}}–{{adc.max}} V"
      },
      {
        "text": "Divider source measurement range ≈ {{calc.sourceMin}}–{{calc.sourceMax}} V",
        "when": [
          "lte",
          {
            "ref": "calc.sourceMin"
          },
          {
            "ref": "calc.sourceMax"
          }
        ]
      },
      {
        "text": "Divider ratio too large for this configured source-voltage range",
        "severity": "danger",
        "when": [
          "gt",
          {
            "ref": "calc.sourceMin"
          },
          {
            "ref": "calc.sourceMax"
          }
        ]
      },
      {
        "text": "{{params.sourceV}} V source → {{calc.pinVoltage}} V at pin"
      },
      {
        "text": "UNSAFE · above the configured GPIO voltage ceiling",
        "severity": "danger",
        "when": [
          "gt",
          {
            "ref": "calc.pinVoltage"
          },
          {
            "ref": "board.signal.max"
          }
        ]
      },
      {
        "text": "Outside the characterized ADC measurement range",
        "when": [
          "or",
          [
            "gt",
            {
              "ref": "calc.pinVoltage"
            },
            {
              "ref": "adc.max"
            }
          ],
          [
            "lt",
            {
              "ref": "calc.pinVoltage"
            },
            {
              "ref": "adc.min"
            }
          ]
        ]
      }
    ],
    "components": [
      "R1: {{params.rTop}} kΩ, 1%, ¼ W",
      "R2: {{params.rBottom}} kΩ, 1%, ¼ W",
      "C1: {{params.capNf}} nF ceramic, ≥10 V, optional noise filter"
    ],
    "notes": [
      "This example uses 1–1000 kΩ resistors and a source of at most 12 V DC.",
      "Vpin = Vsource ÷ {{calc.ratio}}. For source volts, use scale {{calc.ratio}} and offset 0. Preset scale: {{channel.scale}}; offset: {{channel.offset}}; unit: {{channel.unit}}.",
      "The GPIO ceiling corresponds to {{calc.sourcePinLimit}} V at the source with ideal resistors. Use the lower measurement range, with margin for tolerance and spikes.",
      "C1 connects from the ADC node to GND, close to the board. It filters fast changes; omit it for faster analog signals. Do not add a filter capacitor to digital data.",
      "High resistor values increase source impedance and measurement error. Verify against a reference.",
      "The ideal RC corner is about {{calc.cutoffHz}} Hz. Software scaling does not change the physical circuit."
    ],
    "sources": []
  },
